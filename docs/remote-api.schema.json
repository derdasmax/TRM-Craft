        "id",
        "name",
        "edition",
        "loader",
        "mcVersion",
        "status",
        "players",
        "port",
        "uptimeMs"
      ],
      "additionalProperties": false
    },
    "UploadBeginRequest": {
      "type": "object",
      "properties": {
        "uploadId": {
          "type": "string",
          "pattern": "^[\\w-]{4,64}$"
        },
        "serverId": {
          "type": "string",
          "maxLength": 40
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "size": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{64}$"
        },
        "restartAfter": {
          "type": "boolean"
        }
      },
      "required": [
        "serverId",
        "fileName",
        "size",
        "sha256"
      ],
      "additionalProperties": false
