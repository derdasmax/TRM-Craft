{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://trm-craft/remote-api.schema.json",
  "title": "TRM-Craft Remote-API",
  "description": "Schemas der App-eigenen Remote-API (HTTPS-REST + WebSocket). Quelle: packages/remote/src/protocol.ts. Neu erzeugen mit UPDATE_SCHEMA=1.",
  "protocolVersion": 2,
  "minProtocolVersion": 2,
  "apiBase": "/api/v1",
  "errorCodes": [
    "unauthorized",
    "disabled",
    "origin_not_allowed",
    "host_not_allowed",
    "rate_limited",
    "unknown_command",
    "local_only",
    "forbidden",
    "invalid_args",
    "not_found",
    "conflict",
    "server_running",
    "no_permission",
    "too_large",
    "unsupported_type",
    "wrong_loader",
    "checksum_mismatch",
    "network",
    "incompatible",
    "internal"
  ],
  "uploadExtensions": [
    ".jar",
    ".zip",
    ".mrpack",
    ".mcpack",
    ".mcaddon"
  ],
  "definitions": {
    "Info": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "const": "TRM-Craft"
        },
        "appVersion": {
          "type": "string"
        },
        "protocolVersion": {
          "type": "integer"
        },
        "minProtocolVersion": {
          "type": "integer"
        },
        "deviceName": {
          "type": "string"
        },
        "tunnel": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "appVersion",
        "protocolVersion",
        "minProtocolVersion",
        "deviceName",
        "tunnel"
      ],
      "additionalProperties": false
    },
    "PairRequest": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{4,24}$"
        },
        "siteName": {
          "type": "string",
          "maxLength": 80
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false
    },
    "PairResponse": {
      "type": "object",
      "properties": {
        "deviceToken": {
          "type": "string"
        },
        "deviceId": {
          "type": "string"
        },
        "deviceName": {
          "type": "string"
        },
        "perms": {
          "type": "object",
          "properties": {
            "upload": {
              "type": "boolean"
            }
          },
          "required": [
            "upload"
          ],
          "additionalProperties": false
        },
        "maxRole": {
          "type": "string",
          "enum": [
            "viewer",
            "moderator",
            "admin"
          ]
        }
      },
      "required": [
        "deviceToken",
        "deviceId",
        "deviceName",
        "perms",
        "maxRole"
      ],
      "additionalProperties": false
    },
    "SessionRequest": {
      "type": "object",
      "properties": {
        "user": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "enum": [
            "owner",
            "admin",
            "moderator",
            "viewer"
          ]
        },
        "ttlSec": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        }
      },
      "required": [
        "user",
        "role"
      ],
      "additionalProperties": false
    },
    "SessionResponse": {
      "type": "object",
      "properties": {
        "sessionToken": {
          "type": "string"
        },
        "expiresAt": {
          "type": "number"
        },
        "role": {
          "type": "string",
          "enum": [
            "owner",
            "admin",
            "moderator",
            "viewer"
          ]
        },
        "perms": {
          "type": "object",
          "properties": {
            "upload": {
              "type": "boolean"
            }
          },
          "required": [
            "upload"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "sessionToken",
        "expiresAt",
        "role",
        "perms"
      ],
      "additionalProperties": false
    },
    "Me": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "device",
            "session"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "owner",
            "admin",
            "moderator",
            "viewer"
          ]
