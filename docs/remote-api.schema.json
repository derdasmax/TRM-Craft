        "received": {
          "type": "integer"
        },
        "size": {
          "type": "integer"
        },
        "error": {
          "type": "string"
        }
      },
      "required": [
        "uploadId",
        "status",
        "received",
        "size"
      ],
      "additionalProperties": false
    },
